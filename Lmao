public interface IMemReader
{
    bool Read(ulong addr, Span<byte> dst);
}

public static class Analyzer
{
    public static (byte[] bytes, bool[] mask) ParsePattern(string pat)
    {
        var tok = pat.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var b = new byte[tok.Length];
        var m = new bool[tok.Length];
        for (int i = 0; i < tok.Length; i++)
        {
            if (tok[i] == "??" || tok[i] == "?") { m[i] = false; continue; }
            b[i] = Convert.ToByte(tok[i], 16);
            m[i] = true;
        }
        return (b, m);
    }

    public static List<int> AobScan(ReadOnlySpan<byte> data, string pattern)
    {
        var (pb, pm) = ParsePattern(pattern);
        var hits = new List<int>();
        for (int i = 0; i <= data.Length - pb.Length; i++)
        {
            bool ok = true;
            for (int j = 0; j < pb.Length; j++)
                if (pm[j] && data[i + j] != pb[j]) { ok = false; break; }
            if (ok) hits.Add(i);
        }
        return hits;
    }

    public static bool TryResolveChain(IMemReader mem, ulong baseAddr, ReadOnlySpan<long> offsets, out ulong result)
    {
        result = 0;
        ulong cur = baseAddr;
        Span<byte> buf = stackalloc byte[8];
        for (int i = 0; i < offsets.Length; i++)
        {
            ulong addr = (ulong)((long)cur + offsets[i]);
            if (i == offsets.Length - 1) { result = addr; return true; }
            if (!mem.Read(addr, buf)) return false;
            cur = BitConverter.ToUInt64(buf);
            if (cur == 0) return false;
        }
        result = cur;
        return true;
    }

    public static bool ReadVec3(IMemReader mem, ulong addr, out (float x, float y, float z) v)
    {
        Span<byte> b = stackalloc byte[12];
        v = default;
        if (!mem.Read(addr, b)) return false;
        v = (BitConverter.ToSingle(b[0..4]), BitConverter.ToSingle(b[4..8]), BitConverter.ToSingle(b[8..12]));
        return true;
    }

    public static bool WorldToScreen(float[] m, (float x, float y, float z) p, float sw, float sh, out (float x, float y) s)
    {
        s = default;
        float w = m[12] * p.x + m[13] * p.y + m[14] * p.z + m[15];
        if (w < 0.001f) return false;
        float cx = m[0] * p.x + m[1] * p.y + m[2] * p.z + m[3];
        float cy = m[4] * p.x + m[5] * p.y + m[6] * p.z + m[7];
        s = (sw / 2f * (1f + cx / w), sh / 2f * (1f - cy / w));
        return true;
    }
}

public static class AnalyzerExtensions
{
    public static bool ReadMatrix(IMemReader mem, ulong addr, out float[] matrix)
    {
        matrix = new float[16];
        Span<byte> buf = stackalloc byte[64];
        if (!mem.Read(addr, buf)) return false;
        for (int i = 0; i < 16; i++)
        {
            matrix[i] = BitConverter.ToSingle(buf.Slice(i * 4, 4));
        }
        return true;
    }

    public static List<ulong> GetValidEntities(IMemReader mem, ulong entityListBase, int maxEntities)
    {
        var validEntities = new List<ulong>();
        Span<byte> buf = stackalloc byte[8];
        for (int i = 0; i < maxEntities; i++)
        {
            ulong entryAddr = entityListBase + (ulong)(i * 8);
            if (!mem.Read(entryAddr, buf)) continue;
            ulong entityPtr = BitConverter.ToUInt64(buf);
            if (entityPtr != 0 && entityPtr > 0x1000000000UL)
            {
                validEntities.Add(entityPtr);
            }
        }
        return validEntities;
    }
}
