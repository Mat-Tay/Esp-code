// --- TẦNG 4: MÓC NỐI ĐƯỜNG ỐNG ĐỒ HỌA & KẾT XUẤT HUD (eglSwapBuffers Hook) ---
typedef EGLBoolean (*orig_eglSwapBuffers)(EGLDisplay dpy, EGLSurface surface);
orig_eglSwapBuffers original_eglSwapBuffers = nullptr;

bool g_ImGuiInitialized = false;
int g_WindowWidth = 0;
int g_WindowHeight = 0;

EGLBoolean hooked_eglSwapBuffers(EGLDisplay dpy, EGLSurface surface) {
    // Lấy thông số độ phân giải màn hình thời gian thực
    eglQuerySurface(dpy, surface, EGL_WIDTH, &g_WindowWidth);
    eglQuerySurface(dpy, surface, EGL_HEIGHT, &g_WindowHeight);

    // Khởi tạo ImGui ở frame đầu tiên
    if (!g_ImGuiInitialized) {
        IMGUI_CHECKVERSION();
        ImGui::CreateContext();
        ImGuiIO& io = ImGui::GetIO();
        ImGui_ImplOpenGL3_Init("#version 300 es");
        ImGui::StyleColorsDark();
        g_ImGuiInitialized = true;
        LOGI("ImGui pipeline initialized. Dimensions: %dx%d", g_WindowWidth, g_WindowHeight);
    }

    ImGui_ImplOpenGL3_NewFrame();
    ImGui::NewFrame();

    // Thiết lập cửa sổ vẽ đè trong suốt toàn màn hình
    ImGui::SetNextWindowSize(ImVec2((float)g_WindowWidth, (float)g_WindowHeight), ImGuiCond_Always);
    ImGui::SetNextWindowPos(ImVec2(0, 0), ImGuiCond_Always);
    ImGui::Begin("HUD_Overlay_Layer", nullptr, 
        ImGuiWindowFlags_NoBackground | 
        ImGuiWindowFlags_NoDecoration | 
        ImGuiWindowFlags_NoInputs | 
        ImGuiWindowFlags_NoSavedSettings);

    ImDrawList* drawList = ImGui::GetWindowDrawList();

    // Lấy dữ liệu tọa độ đã được tính toán từ luồng phân tích ở trên để vẽ đè
    pthread_mutex_lock(&g_Mutex);
    for (const auto& entity : g_RenderEntities) {
        if (entity.isValid) {
            // Vẽ hộp hoặc thông tin vị trí dựa trên tọa độ 2D WorldToScreen đã giải mã
            drawList->AddRect(
                ImVec2(entity.screenX - 20, entity.screenY - 40), 
                ImVec2(entity.screenX + 20, entity.screenY + 40), 
                IM_COL32(0, 255, 0, 255), 1.0f
            );
        }
    }
    pthread_mutex_unlock(&g_Mutex);

    ImGui::End();

    // Kết xuất khung hình đồ họa của ImGui ra màn hình
    ImGui::Render();
    ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());

    return original_eglSwapBuffers(dpy, surface);
}
